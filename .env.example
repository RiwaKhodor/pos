# Copy to `.env` and fill in values from your Supabase project.
# Dashboard → Project Settings → Database

# Pooled connection (Transaction mode / port 6543) — used by the running app
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection (port 5432) — used by Prisma migrate
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Or use the direct host form from Supabase:
# DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# Auth signing secret (long random string). Never expose to the browser/Electron renderer.
JWT_SECRET="change-me-to-a-long-random-secret"

# Web Push keys for the owner phone. Generate with `npx web-push generate-vapid-keys`.
# The public key can be sent to the browser. The private key stays on the server.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:owner@store.com"

# Do NOT put Supabase service-role keys in this app. Prisma uses DATABASE_URL only on the server.
